# Copy this file to .env and fill in your key. NEVER put a real key in this file (it is committed).
# Groq (free): https://console.groq.com/keys
LLM_API_KEY=paste_your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# gpt-oss "thinking" level: low (fewer tokens) | medium (more reliable, default)
LLM_REASONING_EFFORT=medium

# Local model instead (Ollama):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_REASONING_EFFORT=
# LLM_STRICT_SCHEMA=0

# Set to 0 to stop the report opening in the browser after a full run
OPEN_BROWSER=1
